{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ site.Title }}</title><link>{{ site.Home.Permalink }}</link><description/><atom:link href="{{ (.OutputFormats.Get "RSS").Permalink }}" rel="self"/><lastBuildDate>{{ (index .RegularPagesRecursive 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
{{- range .RegularPagesRecursive }}
{{- $summary := partial "summary.html" (partial "widont.html" (string .Content)) }}
<item><title>{{ .Title | htmlUnescape }}</title><link>{{ .Permalink }}</link><description>{{ $summary.html }}</description><dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">{{ index .Params.authors 0 }}</dc:creator><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate><guid>tag:skreel.org,{{ .Date.Format "2006-01-02" }}:{{ .RelPermalink }}</guid><category>{{ index .Params.categories 0 }}</category></item>
{{- end }}
</channel></rss>
